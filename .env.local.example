NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
# BestTime.app private API key — server-only, never exposed to the browser.
BESTTIME_API_KEY=your-besttime-private-key-here
# Random token; must match the 'forecast_sync_secret' row in the app_secrets
# table (see schema.sql).
FORECAST_SYNC_SECRET=generate-a-random-token-here
# Random token; also set as an env var of the same name in Vercel's project
# settings so Vercel's cron requests authenticate automatically.
CRON_SECRET=generate-a-different-random-token-here
